# Postgres
VB_DB_NAME=openbrain
VB_DB_USER=postgres
VB_DB_PASSWORD=postgres

# Ollama (host)
VB_OLLAMA_URL=http://host.docker.internal:11434

# Webui
VB_MAX_UPLOAD_MB=500
VB_INGEST_WORKER_COUNT=2

# Folder watcher: which space watched files land in (default Common)
VB_WATCH_SPACE=Common

# Claude
ANTHROPIC_API_KEY=
